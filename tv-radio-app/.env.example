# Copier vers .env.local (dev) ou variables système (prod)
#
# Connexion dashboard : JWT_SECRET (≥ 32 car. en prod) + ADMIN_PASSWORD_HASH (bcrypt) obligatoires en production.
JWT_SECRET=remplacer-par-une-chaine-longue-aleatoire-min-32-caracteres
# Obligatoire en prod — générer : node -e "console.log(require('bcryptjs').hashSync('VOTRE_MDP',12))"
ADMIN_PASSWORD_HASH=
# Repli DEV uniquement (ignoré si NODE_ENV=production) — ne jamais préfixer NEXT_PUBLIC_
# ADMIN_PASSWORD=

# Optionnel : chemins ops (alignement /opt/streaming → même contenu que /srv)
# STREAMING_BASE_PATH=/srv
# SRT_STREAMS_REGISTRY_PATH=/srv/srt-streams.json
# GEOLITE2_COUNTRY_PATH=/var/lib/GeoIP/GeoLite2-Country.mmdb
# NGINX_ACCESS_LOG=/var/log/nginx/access.log
# SRT_UDP_PORT_FROM=6000
# SRT_UDP_PORT_TO=6100
#
# Enregistrements (HLS → MKV -c copy, voir GET /api/recordings/sources)
# RECORDINGS_DIR=/srv/recordings
# Espace libre minimum (%) sur la partition de RECORDINGS_DIR — refus HTTP 507 si en dessous
# RECORDINGS_MIN_FREE_PERCENT=15
# Origine HTTP locale pour FFmpeg (évite HTTPS public / TLS / DNS) — ex. http://127.0.0.1
# RECORDINGS_FFMPEG_INPUT_ORIGIN=http://127.0.0.1
# PUBLIC_STREAM_ORIGIN=https://stream.broadcastsn.com
# RTMP_STREAMS_REGISTRY_PATH=/srv/rtmp-streams.json
