# =============================================================================
# TOUBA TV — appttv (admin web + vMix XML)
# Copier : cp .env.example .env
# Emplacement VPS : /opt/toubatv/appttv/.env
# =============================================================================

# --- Serveur Node (PM2) -------------------------------------------------------
NODE_ENV=production
HOST=127.0.0.1
PORT=3010

# Chemin public HTTPS (sans slash final)
BASE_PATH=/appttv
PUBLIC_BASE_URL=https://stream.broadcastsn.com/appttv

# --- Flux live TOUBA TV (utilisé à l'initialisation Firestore) ---------------
LIVE_HLS_URL=https://stream.broadcastsn.com/toubatv/index.m3u8

# --- Firebase Admin (compte de service — JAMAIS dans le navigateur) ----------
FIREBASE_PROJECT_ID=touba-tv-823d7
GOOGLE_APPLICATION_CREDENTIALS=/opt/toubatv/service-account.json

# --- Firebase Web (connexion Google admin — console → App Web) ---------------
FIREBASE_API_KEY=AIzaSyBdezvkE71PxDPONyNmYhTuTEmg8bVgQYQ
FIREBASE_AUTH_DOMAIN=touba-tv-823d7.firebaseapp.com
FIREBASE_STORAGE_BUCKET=touba-tv-823d7.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=68793261862
# Obligatoire : Project settings → Your apps → Web → appId
FIREBASE_WEB_APP_ID=

# --- vMix (machine distante — protège les URLs XML) ---------------------------
# Même valeur dans vMix : ?token=... ou en-tête X-Vmix-Token
VMIX_DS_TOKEN=changez-moi-en-production

# --- Stockage VPS (messages + photos sur le serveur) --------------------------
# Activé par défaut. Dossier créé automatiquement au premier envoi.
VPS_STORAGE_ENABLED=true
VPS_DATA_DIR=/opt/toubatv/appttv/data/vps

# --- Google Drive (optionnel — sauvegarde secondaire) -------------------------
# Voir deploy/GOOGLE-DRIVE.md — partager le dossier avec firebase-adminsdk-fbsvc@...
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_FOLDER_ID=18Bi3LLPT0fWOy_Smgs9gkvyC0neL9M9m
